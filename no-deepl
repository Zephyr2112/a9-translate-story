// ==UserScript==
// @name         Arknights Story - Dịch song ngữ Việt
// @namespace    khoa.arknights.translate
// @version      4.1
// @description  Tự động dịch câu thoại, tên người nói, và sticker chữ trên canvas sang tiếng Việt
// @match        https://arknights.timo.beer/story.html*
// @grant        GM_xmlhttpRequest
// @connect      translate.googleapis.com
// ==/UserScript==

(function () {
  'use strict';

  const cache = new Map();

  function toTitleCase(str) {
    return str
      .split(' ')
      .map(word => {
        if (!word) return word;
        return word.charAt(0).toUpperCase() + word.slice(1);
      })
      .join(' ');
  }

  function translateText(text, callback) {
    if (cache.has(text)) {
      callback(cache.get(text));
      return;
    }
    const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=en&tl=vi&dt=t&q=${encodeURIComponent(text)}`;
    GM_xmlhttpRequest({
      method: 'GET',
      url: url,
      onload: function (res) {
        try {
          const json = JSON.parse(res.responseText);
          const translated = json[0].map(part => part[0]).join('');
          cache.set(text, translated);
          callback(translated);
        } catch (e) {
          callback('(Không dịch được)');
        }
      },
      onerror: function () {
        callback('(Lỗi kết nối dịch)');
      }
    });
  }

  function ensureTranslationBox() {
    let box = document.getElementById('vnViText');
    if (!box) {
      box = document.createElement('div');
      box.id = 'vnViText';
      box.style.cssText = `
        margin-top: 6px;
        padding-top: 6px;
        border-top: 1px solid rgba(255,255,255,0.25);
        color: #ffd479;
        font-style: normal;
        font-family: "Noto Sans", "Segoe UI", "Arial", "Helvetica Neue", sans-serif;
        font-weight: 400;
        font-size: 0.95em;
        line-height: 1.5;
        letter-spacing: normal;
      `;
      const dialogBox = document.getElementById('vnDialogBox');
      if (dialogBox) dialogBox.appendChild(box);
    }
    return box;
  }

  function ensureSpeakerTranslationSpan() {
    let span = document.getElementById('vnViSpeaker');
    if (!span) {
      span = document.createElement('span');
      span.id = 'vnViSpeaker';
      span.style.cssText = `
        margin-left: 6px;
        font-style: normal;
        font-family: "Segoe UI", "Noto Sans", "Roboto", "Helvetica Neue", Arial, sans-serif;
        font-weight: 500;
        font-size: 0.9em;
        color: #e0e0e0;
        opacity: 0.9;
      `;
      const speakerEl = document.getElementById('vnSpeakerName');
      if (speakerEl) speakerEl.appendChild(span);
    }
    return span;
  }

  let lastSeenText = '';
  let stableTextFrames = 0;

  let lastSeenSpeaker = '';
  let stableSpeakerFrames = 0;

  // Theo dõi trạng thái ổn định riêng cho từng sticker (vì có thể có nhiều cái cùng lúc)
  const stickerState = new WeakMap();

  function processStickers() {
    const stickers = document.querySelectorAll('#vnCanvas .vn-sticker');
    stickers.forEach(el => {
      if (el.dataset.viTranslated === '1') return; // đã dịch rồi thì bỏ qua

      const text = el.textContent.trim();
      let state = stickerState.get(el);
      if (!state) {
        state = { lastText: '', stable: 0 };
        stickerState.set(el, state);
      }

      if (text === state.lastText) {
        state.stable++;
      } else {
        state.stable = 0;
        state.lastText = text;
      }

      if (state.stable === 3 && text) {
        el.dataset.viTranslated = '1'; // đánh dấu để không dịch lặp lại
        translateText(text, (translated) => {
          if (translated.trim().toLowerCase() === text.trim().toLowerCase()) return;
          const br = document.createElement('br');
          const span = document.createElement('span');
          span.style.cssText = `
            font-size: 0.8em;
            opacity: 0.85;
            font-family: "Noto Sans", "Segoe UI", Arial, sans-serif;
            display: inline-block;
            margin-top: 2px;
          `;
          span.textContent = translated;
          el.appendChild(br);
          el.appendChild(span);
        });
      }
    });
  }

  let rafId = null;

  function watchLoop() {
    // --- Câu thoại ---
    const textEl = document.getElementById('vnText');
    if (textEl) {
      const current = textEl.textContent.trim();

      if (current === lastSeenText) {
        stableTextFrames++;
      } else {
        stableTextFrames = 0;
        lastSeenText = current;
      }

      if (stableTextFrames === 3) {
        const box = ensureTranslationBox();
        if (!current || current === '......' || current === '...') {
          box.textContent = '';
        } else {
          box.textContent = 'Đang dịch...';
          translateText(current, (translated) => {
            if (textEl.textContent.trim() === current) {
              box.textContent = translated;
            }
          });
        }
      }
    }

    // --- Tên người nói ---
    const speakerEl = document.getElementById('vnSpeakerName');
    if (speakerEl) {
      const speakerSpan = document.getElementById('vnViSpeaker');
      const rawSpeaker = speakerSpan
        ? speakerEl.textContent.replace(speakerSpan.textContent, '').trim()
        : speakerEl.textContent.trim();

      if (rawSpeaker === lastSeenSpeaker) {
        stableSpeakerFrames++;
      } else {
        stableSpeakerFrames = 0;
        lastSeenSpeaker = rawSpeaker;
      }

      if (stableSpeakerFrames === 3) {
        const span = ensureSpeakerTranslationSpan();
        if (!rawSpeaker || rawSpeaker === '???') {
          span.textContent = '';
        } else {
          translateText(rawSpeaker, (translated) => {
            if (translated.trim().toLowerCase() === rawSpeaker.trim().toLowerCase()) {
              span.textContent = '';
            } else {
              const titled = toTitleCase(translated.trim());
              span.textContent = `(${titled})`;
            }
          });
        }
      }
    }

    // --- Sticker chữ trên canvas ---
    processStickers();

    rafId = requestAnimationFrame(watchLoop);
  }

  function startWatching() {
    const textEl = document.getElementById('vnText');
    if (!textEl) {
      setTimeout(startWatching, 500);
      return;
    }
    if (rafId) cancelAnimationFrame(rafId);
    watchLoop();
  }

  window.addEventListener('load', () => {
    setTimeout(startWatching, 800);
  });
})();
